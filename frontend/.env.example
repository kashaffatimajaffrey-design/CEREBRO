# Frontend configuration. All VITE_* vars are PUBLIC — they ship in the bundle.
# Never put a secret here.

# Base URL of the CEREBRO API.
# Leave blank in development: vite.config.ts proxies /v1 to localhost:8000.
# In production set this to your Railway URL, e.g. https://cerebro-api.up.railway.app
VITE_API_BASE=
