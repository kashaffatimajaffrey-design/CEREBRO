# ---------------------------------------------------------------------
# CEREBRO v2 — copy to .env and fill in. .env is gitignored.
#
# Note: the platform runs fully with NO API keys. Local models only.
# The hosted-provider keys below are optional fallbacks.
# ---------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------
POSTGRES_USER=cerebro
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=cerebro
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cerebro:change_me_in_production@localhost:5432/cerebro

REDIS_URL=redis://localhost:6379/0

# Session cookie SameSite policy. Use 'none' for a SPLIT deploy (frontend and API
# on different domains) — the code then forces Secure. Leave 'lax' for same-origin
# (the dev proxy, or a single domain). See infra/DEPLOY.md.
SESSION_COOKIE_SAMESITE=lax

# --- Object storage ---------------------------------------------------
MINIO_USER=cerebro
MINIO_PASSWORD=change_me_in_production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cerebro-artifacts

# --- LLM (explanation generation only, never classification) ----------
# Chain: primary, then fallbacks, then a built-in template that cannot fail.
# For a live demo:  LLM_PROVIDER=groq  LLM_FALLBACKS=cerebras,ollama
LLM_PROVIDER=groq
LLM_FALLBACKS=cerebras,ollama

# Groq — best free hosted tier (July 2026): 30 RPM / 14,400 RPD, no card.
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras — second free tier, same ballpark limits. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# --- Trained model artifacts (optional) -------------------------------
# When set and present, these flip a module from heuristic/unfitted to a real
# model at startup. Produce them with scripts/train_*.py (see backend/data/README.md).
EMAIL_CLASSIFIER_PATH=
ANOMALY_MODEL_PATH=

# --- Google OAuth (server-side Gmail token exchange) ------------------
# Client id is public; the secret must never reach the browser. Required only
# for /v1/auth/google/exchange. Rotate these in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ollama — fully local, no key, no network, no rate limit.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Lower-RAM alternatives: qwen2.5:3b-instruct  |  phi3.5:3.8b-mini-instruct-q4_0

# Optional. Leave blank — nothing requires these.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local models (downloaded once from HuggingFace) ------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=roberta-large-mnli

# --- Security ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# --- External data sources (all free tiers) ---------------------------
GOOGLE_FACTCHECK_API_KEY=
GDELT_ENABLED=true

# --- Google OAuth (server-side only; tokens never reach the browser) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
